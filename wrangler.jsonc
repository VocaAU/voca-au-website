{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "voca-au-website",
	"main": "./src/worker.ts",
	"compatibility_date": "2026-03-29",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "voca-au-database","database_id": "ef1ded53-e78c-468e-a6af-9b013a78e856",
			// Run `wrangler d1 create my-emdash-site` and paste the ID here
		},
	],
	"r2_buckets": [
		{
			"binding": "MEDIA",
			"bucket_name": "voca-au-media","preview_bucket_name": "voca-au-media",
		},
	],
	"observability": {
		"enabled": true,
	},
	"worker_loaders": [
		{
			"binding": "LOADER",
		},
	],
}